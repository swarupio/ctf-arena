# Copy to .env in the repository root. Replace placeholders privately.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ctf_arena
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_REPLACE_ME
COGNITO_CLIENT_ID=replace_me
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_REPLACE_ME
VITE_COGNITO_CLIENT_ID=replace_me
PUBLIC_HOST=localhost
# Set a private random value of at least 32 characters before using flags.
FLAG_SECRET=replace_with_a_private_random_secret
CHALLENGE_PORT_MIN=30000
CHALLENGE_PORT_MAX=30100
INSTANCE_TTL_MINUTES=30
MAX_INSTANCES_PER_TEAM=2
CHALLENGE_MEMORY_MB=128
CHALLENGE_CPU_LIMIT=0.25
CHALLENGE_PIDS_LIMIT=64
