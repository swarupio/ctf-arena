# Copy to .env in the repository root. Replace placeholders privately.
NODE_ENV=development
PORT=4000
# This placeholder works for health only with standalone MongoDB. Teams and seed
# require Atlas or a local replica set. Each developer must allow their IP/range
# in Atlas Network Access. In Compose, 127.0.0.1 refers to the backend container.
MONGODB_URI=mongodb://127.0.0.1:27017/ctf_arena
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_REPLACE_ME
COGNITO_CLIENT_ID=replace_me
VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_REPLACE_ME
VITE_COGNITO_CLIENT_ID=replace_me
# Optional, off by default. true = an ADMIN token without Cognito's amr claim is treated as not MFA-verified (admin routes
# answer 403 ADMIN_MFA_REQUIRED). Turn it on only after you have seen amr in your own tokens (docs/SECURITY.md).
# ADMIN_REQUIRE_MFA_CLAIM=true
# Keep backend/frontend Cognito values aligned; region must match the pool prefix.
# VITE_ settings are public build-time values: rebuild the frontend after changes.
# All variables in this template are required by backend config, including the
# Phase 2 limits below. No extra seed variables are needed.
PUBLIC_HOST=localhost
# Set a private random value of at least 32 characters before using flags.
FLAG_SECRET=replace_with_a_private_random_secret
CHALLENGE_PORT_MIN=30000
CHALLENGE_PORT_MAX=30100
INSTANCE_TTL_MINUTES=30
MAX_INSTANCES_PER_TEAM=2
CHALLENGE_MEMORY_MB=128
CHALLENGE_CPU_LIMIT=0.25
CHALLENGE_PIDS_LIMIT=64

# DOCKER_ENABLED: Docker challenges (a private container per team). Accepts true, false, 1 or 0 (anything else stops
# startup). Default true locally, false on Vercel, where containers cannot run (instance routes then answer 503
# DOCKER_DISABLED; the reaper and the admin dashboard also honour it). Leave unset in normal use.
# DOCKER_ENABLED=true

# MONGOOSE_AUTO_INDEX: build MongoDB indexes at startup. Default true locally, false on Vercel (cold-start cost).
# With false, run `npm run db:indexes` in backend/ after deploying a schema change. Read directly from process.env.
# MONGOOSE_AUTO_INDEX=true

# Optional Docker Compose settings (used by docker-compose.yml, not by the backend code; leave commented on a laptop).
# DOCKER_GID: group id of /var/run/docker.sock so the non-root backend can start challenge containers.
#   On Linux: DOCKER_GID=$(getent group docker | cut -d: -f3). The default 0 works on Docker Desktop.
# DOCKER_GID=0
# NGINX_HOST_PORT: host port the website is published on. Default 80; change it if something else uses 80.
# NGINX_HOST_PORT=80

# Optional development settings (read from the environment by the tools, not required by the backend config).
# API_PROXY_TARGET: where the Vite dev server (frontend, npm run dev) proxies /api. Default http://localhost:4000.
# API_PROXY_TARGET=http://localhost:4000
# ARENA_TERMINAL_DEBUG: when set, internal Arena Terminal errors are rethrown instead of printed as "internal error". Debugging only.
# ARENA_TERMINAL_DEBUG=1
